# Copy to server/.env (never committed) and fill in. Production sets these as real
# environment variables instead. See docs/oracle-setup.md §6.

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Development database: the DROPSHARE_DEV schema on the PDB service (not the CDB root).
DB_DIALECT=[postgresql|oracle]
DB_HOST=<host-ip>
DB_PORT=1521
DB_NAME=test_db
DB_USER=DROPSHARE_DEV
DB_PASSWORD=<dev-password>
# Connection pool per server process.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Test database used by `uv run pytest server/tests`. Tests migrate it to head and wipe its data.
TEST_DB_DIALECT=[postgresql|oracle]
TEST_DB_HOST=<host-ip>
TEST_DB_PORT=1521
TEST_DB_NAME=test_db
TEST_DB_USER=DROPSHARE_TEST
TEST_DB_PASSWORD=<test-password>

# File storage. Only "local" exists until OQ-2 is decided.
STORAGE_BACKEND=local

# It must already exist (the server refuses to start otherwise), e.g. `mkdir -p var/storage`.
# Directory for blobs and upload staging; relative paths resolve from the working directory.
STORAGE_LOCAL_ROOT=./var/storage


TOKEN_SECRET=<random-secret>
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_INACTIVITY_DAYS=30
REFRESH_TOKEN_ABSOLUTE_DAYS=90
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
# Clients older than this get 426 UPGRADE_REQUIRED (FR-UPD-04). The latest stable release's
# minimum supported version raises it further, never lowers it.
MIN_CLIENT_VERSION=0.2.0
# Who must have signed every published installer (FR-UPD-02): the certificate's name (CN), and
# a JSON list of pinned certificate SHA-256s (printed by scripts/build_client.ps1; two while a
# renewed certificate is rolled out). Either empty: publishing is refused. The organization's
# certificate once OQ-6 is settled; the test certificate until then.
RELEASE_PUBLISHER=
RELEASE_CERT_SHA256=[]
# Default quota for new users, in bytes (50 GiB).
DEFAULT_QUOTA_BYTES=53687091200
# JSON list of reverse-proxy IPs whose X-Forwarded-For is trusted, e.g. ["10.0.0.5"].
TRUSTED_PROXIES=[]

# Files and transfers (FR-XFER-01, NFR-SCALE-01). 2,000 MiB, so every file fits the malware
# scanner: ClamAV can't scan a file over 2 GiB, so never set this higher (D18, OQ-58 (4)).
MAX_FILE_SIZE_BYTES=2097152000
# Banned file types (FR-SAFE-02, OQ-57): a JSON list of last extensions, matched without regard
# to case. An invalid entry stops the server at startup. Unset: the list below.
BANNED_EXTENSIONS=[".exe", ".dll", ".msi", ".bat", ".cmd", ".com", ".scr", ".ps1", ".vbs", ".js", ".jse", ".wsf", ".hta", ".jar", ".lnk", ".reg", ".iso"]
UPLOAD_CHUNK_SIZE_BYTES=8388608
# Malware scanner (FR-SAFE-01): clamd's address. There is no setting to turn scanning off
# (OQ-58): run the clamav container (docs/clamav-setup.md) and the scan worker
# (`dropshare-server jobs run scan-uploads --loop`). While clamd can't be reached, uploads wait.
CLAMD_HOST=localhost
CLAMD_PORT=3310
CLAMD_CONNECT_TIMEOUT_SECONDS=5
CLAMD_REPLY_TIMEOUT_SECONDS=900
# Files up to this size (64 MiB) are scanned within the upload request; larger ones by the worker.
SCAN_INLINE_MAX_BYTES=67108864
# A scan within a request gives up after this long, in total, and leaves the file to the worker.
SCAN_INLINE_TIMEOUT_SECONDS=30
# The scan worker's longest pause while clamd is down.
SCAN_RETRY_MAX_SECONDS=300
# Failed scans of one file before it is refused as unscannable (never published unscanned).
SCAN_MAX_ATTEMPTS=5
UPLOAD_EXPIRY_HOURS=24
# Long-poll (FR-SYNC-03)
LONG_POLL_TIMEOUT_SECONDS=55
LONG_POLL_INTERVAL_SECONDS=1

# Cleanup jobs, run by the OS scheduler: `dropshare-server jobs run <job>` (NFR-REL-05).
# purge-trash: items in the trash longer than this are deleted for good (FR-TRASH-04).
TRASH_RETENTION_DAYS=30
# gc-blobs: replaced versions and unreferenced blobs are removed once older than this.
BLOB_GRACE_HOURS=24
# purge-audit: audit events older than this are removed (FR-AUDIT-03).
AUDIT_RETENTION_DAYS=365
# The account purge-audit uses. In production the app user may only insert and read audit
# rows, so set an account that may delete them. Leave unset in dev/test (uses DB_USER).
# AUDIT_PURGE_DB_USER=DROPSHARE_AUDIT_PURGE
# AUDIT_PURGE_DB_PASSWORD=<purge-password>